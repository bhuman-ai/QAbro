{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/qa/schedules/trigger",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dashboard.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.swarmtester.com"
        }
      ],
      "destination": "https://swarmtester.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.swarmtester.com"
        }
      ],
      "destination": "https://swarmtester.com/:path*",
      "permanent": true
    },
    {
