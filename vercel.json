{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/qa/schedules/trigger",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/dashboard.html",
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/reports.html",
      "destination": "/reports",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.beforeusersdo.com"
        }
      ],
      "destination": "https://beforeusersdo.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.beforeusersdo.com"
        }
      ],
      "destination": "https://beforeusersdo.com/:path*",
