<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="swarm-auth-redirect-origin" content="https://swarmtester.com" />
    <title>Swarm Tester Dashboard</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="reports.css?v=20260330a" />
  </head>
  <body>
<div class="dashboard-grid">
      <header class="dashboard-header">
        <div class="dashboard-header-left">
          <a class="brand" href="/dashboard" aria-label="Swarm Tester dashboard">
            <span class="brand-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 6V3m4.2 1.4-2.1 2.1m-4.2 0L7.8 4.4M7.5 12H4.4m15.2 0h-3.1m-7.8 3.3 1.6 1.6m3.4 0 1.6-1.6M12 18.2V21" />
                </svg>
              </span>
              <span class="brand-label">Swarm Tester</span>
            </a>
        </div>
        <div class="dashboard-header-right">
          <div class="topbar-project-shell" id="topbarProjectShell" hidden aria-hidden="true">
            <label class="topbar-project-switcher" for="brandFilter">
              <span class="topbar-project-label">Project</span>
              <div class="topbar-project-control">
                  <select id="brandFilter" aria-label="Project switcher">
                    <option value="" disabled selected>Loading projects...</option>
                  </select>
                </div>
              </label>
          </div>
          <div class="topbar-actions">
            <div class="theme-mode-control" aria-label="Theme mode" role="group">
                <div class="theme-mode-pills" id="themeModeSwitcher">
                  <button type="button" class="theme-mode-btn" data-theme-mode="light" aria-label="Light mode" title="Light mode">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <circle cx="10" cy="10" r="3.5"></circle>
                      <path d="M10 2.5v2.1M10 15.4v2.1M2.5 10h2.1M15.4 10h2.1M4.8 4.8l1.5 1.5M13.7 13.7l1.5 1.5M4.8 15.2l1.5-1.5M13.7 6.3l1.5-1.5"></path>
                    </svg>
                  </button>
                  <button type="button" class="theme-mode-btn" data-theme-mode="dark" aria-label="Dark mode" title="Dark mode">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M12.8 2.9a7 7 0 1 0 4.3 10.3A6 6 0 1 1 12.8 2.9Z"></path>
                    </svg>
                  </button>
                  <button type="button" class="theme-mode-btn" data-theme-mode="system" aria-label="System theme mode" title="System mode">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <rect x="2.5" y="3.5" width="15" height="10.5" rx="1.5"></rect>
                      <path d="M7.5 16.5h5M10 14v2.5"></path>
                    </svg>
                  </button>
                </div>
            </div>
            <div class="worker-health-chip" id="workerHealthChip" hidden aria-hidden="true" aria-live="polite">
                <span class="worker-health-dot" aria-hidden="true"></span>
                <span class="worker-health-text" id="workerHealthText">Checking workers…</span>
              </div>
            <span class="app-user-chip topbar-user-chip" id="dashboardAuthUserChip" hidden title="Account">QA</span>
            <button class="btn btn-ghost" type="button" data-auth-signout="true" hidden>Sign Out</button>
          </div>
        </div>
      </header>
      <nav class="dashboard-nav" id="dashboardNav" aria-label="Main navigation">
<ul>
  <li><a href="#" class="active" data-panel="runs">Runs</a></li>
  <li><a href="#" data-panel="reports">Reports</a></li>
  <li><a href="#" data-panel="settings">Settings</a></li>
</ul>
      </nav>
      <main class="dashboard-main">
        <div class="dashboard-main-content">
          <div id="qa-dashboard" class="dashboard-auth-shell" data-dashboard-auth-gate="true">
            <article class="card-surface dashboard-auth-card" id="dashboardAuthCard">
              <header>
                <h3>Dashboard Access</h3>
                <p>Create an account or sign in to access brand QA reports.</p>
              </header>

              <div class="dashboard-auth-tabs" role="tablist" aria-label="Authentication mode">
                <button id="authModeSignIn" type="button" role="tab" aria-selected="true">Sign In</button>
                <button id="authModeSignUp" type="button" role="tab" aria-selected="false">Sign Up</button>
              </div>

              <form id="authSignInForm" class="dashboard-auth-form" action="#" method="post" autocomplete="on">
                <label>
                  <span>Email</span>
                  <input name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
                </label>
                <button class="btn btn-primary" type="submit">Send Sign-In Link</button>
              </form>

              <form id="authSignUpForm" class="dashboard-auth-form" action="#" method="post" autocomplete="on" hidden>
                <label>
                  <span>Email</span>
                  <input name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
                </label>
                <label>
                  <span>Invite Code</span>
                  <input name="invite_code" type="text" required autocomplete="off" placeholder="Enter invite code" />
                </label>
                <button class="btn btn-primary" type="submit">Create Account</button>
              </form>

              <p class="app-auth-message" id="authMessage" aria-live="polite"></p>
            </article>

            <section id="dashboardAppShell" class="app-shell" hidden>
              <div class="app-shell-main">
                <div class="app-shell-render-pulse" id="appShellPulse">
                  <div class="app-shell-pulse-grid">
                    <div class="pulse-bar"></div>
                    <div class="pulse-bar"></div>
                    <div class="pulse-bar"></div>
                  </div>
                </div>

                <div class="app-shell-content" id="appShellContent" hidden>
                  <section class="app-panel-header" id="projectPanelHeader" hidden>
                    <div class="app-panel-header-main">
                      <h2 id="projectPanelTitle"></h2>
                      <p id="projectPanelMeta" class="app-panel-header-meta"></p>
                    </div>
                    <div class="app-panel-header-actions">
                      <div id="projectPanelActions"></div>
                      <button class="btn btn-primary btn-new-run" id="projectNewRunButton" type="button">
                        <svg viewBox="0 0 20 20" fill="none">
                          <path d="M10 4.2v11.6m-5.8-5.8h11.6"></path>
                        </svg>
                        <span>New Run</span>
                      </button>
                    </div>
                  </section>

                  <section class="app-panel app-panel-runs" id="runsPanel" hidden>
                    <div class="app-panel-placeholder" id="runsPanelEmpty">
                      <div class="app-panel-placeholder-art">
                        <svg viewBox="0 0 48 48" fill="none">
                          <path d="M21 14 8 24l13 10m6-20 13 10L27 34" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </div>
                      <h3>No runs yet</h3>
                      <p>Completed QA runs for this project will appear here.</p>
                      <button class="btn btn-primary" id="runsPanelNewRunButton" type="button">Start a new run</button>
                    </div>
                    <div class="app-panel-content" id="runsPanelContent"></div>
                  </section>

                  <section class="app-panel app-panel-report-detail" id="reportDetailPanel"></section>
                </div>
              </div>

              <div class="app-shell-sidebar" id="appShellSidebar" hidden>
                <div class="app-shell-sidebar-content" id="appShellSidebarContent"></div>
              </div>
            </section>

            <section id="onboardingShell" class="app-onboarding" hidden>
              <header class="app-onboarding-header">
                <h2 id="onboardingTitle">New QA Run</h2>
                <div class="app-onboarding-tabs" role="tablist" aria-label="Onboarding steps" id="onboardingTabs">
                  <button type="button" role="tab" aria-selected="true" data-step="site">What to test</button>
                  <button type="button" role="tab" aria-selected="false" data-step="personas">Who to be</button>
                  <button type="button" role="tab" aria-selected="false" data-step="goals">What to do</button>
                  <button type="button" role="tab" aria-selected="false" data-step="triage">How to fix</button>
                </div>
              </header>

              <form id="onboardingForm" action="#" method="post" autocomplete="off">
                <div class="app-onboarding-grid">
                  <div class="app-onboarding-main">
                    <section class="onboarding-step" data-step="site">
                      <article class="card-surface onboarding-card-grid">
                        <label>
                          <span>Site URL</span>
                          <input
                            id="onboardingSiteUrl"
                            name="site_url"
                            type="url"
                            required
                            autocomplete="off"
                            placeholder="https://example.com"
                          />
                        </label>
                        <label>
                          <span>Auth entry URL</span>
                          <input
                            id="onboardingAuthUrl"
                            name="auth_url"
                            type="url"
                            autocomplete="off"
                            placeholder="Optional. For example: https://app.example.com/login"
                          />
                        </label>
                      </article>
                      <article class="card-surface">
                        <h4>Login credentials</h4>
                        <div class="onboarding-card-grid">
                          <label>
                            <span>Username or email</span>
                            <input
                              id="onboardingAuthUser"
                              name="auth_user"
                              type="text"
                              autocomplete="off"
                              placeholder="Optional. Saved securely."
                            />
                          </label>
                          <label>
                            <span>Password</span>
                            <input
                              id="onboardingAuthPass"
                              name="auth_pass"
                              type="password"
                              autocomplete="off"
                              placeholder="Optional. Saved securely."
                            />
                          </label>
                        </div>
                      </article>
                    </section>
                    <section class="onboarding-step" data-step="personas" hidden>
                      <div class="card-surface-grid" id="onboardingPersonasGrid"></div>
                    </section>
                    <section class="onboarding-step" data-step="goals" hidden>
                      <article class="card-surface">
                        <div id="onboardingGoalsGrid" class="onboarding-goals-grid"></div>
                      </article>
                    </section>
                    <section class="onboarding-step" data-step="triage" hidden>
                      <article class="card-surface">
                        <label class="app-checkbox-card" for="onboardingRepoTriageEnabled">
                          <input type="checkbox" id="onboardingRepoTriageEnabled" name="repo_triage_enabled" />
                          <span>Code-aware diagnosis</span>
                          <small>Optional. Connect a GitHub repo to let the swarm file bug reports with code snippets and triage hints.</small>
                        </label>
                        <div id="onboardingRepoTriageSetup" hidden>
                          <button class="btn" id="onboardingRepoConnectButton" type="button">Connect GitHub Repo</button>
                          <div id="onboardingRepoConnection" hidden>
                            <p id="onboardingRepoConnectionStatus"></p>
                          </div>
                        </div>
                      </article>
                      <article id="onboardingRepoTriageConfig" class="card-surface" hidden>
                        <h4>Code-aware diagnosis config</h4>
                        <label>
                          <span>Primary branch</span>
                          <input
                            id="onboardingRepoTriageBranch"
                            name="repo_triage_branch"
                            type="text"
                            placeholder="main"
                            autocapitalize="off"
                            spellcheck="false"
                          />
                        </label>
                        <label>
                          <span>Path allowlist</span>
                          <textarea id="onboardingRepoTriagePaths" rows="3" placeholder="Optional. One path per line, for example:\napps/web\npackages/ui"></textarea>
                        </label>
                        <small class="app-field-hint">Use this to keep diagnosis focused on the code that actually owns the tested surface.</small>
                      </article>
                    </section>
                  </div>

                  <aside class="app-onboarding-aside">
                    <section class="onboarding-sidecard">
                      <div class="onboarding-sidecard-head">
                        <h4>Mission summary</h4>
                        <p>This updates as you configure the run.</p>
                      </div>
                      <div class="onboarding-review-grid">
                        <article class="onboarding-review-card">
                          <span class="onboarding-review-label">App</span>
                          <strong id="onboardingReviewSite">Waiting for site</strong>
                          <p id="onboardingReviewSiteMeta">We will start at the public entry point and discover auth if needed.</p>
                        </article>
                        <article class="onboarding-review-card">
                          <span class="onboarding-review-label">Personas</span>
                          <div class="onboarding-review-list" id="onboardingReviewPersonas"></div>
                        </article>
                        <article class="onboarding-review-card">
                          <span class="onboarding-review-label">Primary goals</span>
                          <div class="onboarding-review-list" id="onboardingReviewGoals"></div>
                        </article>
                        <article class="onboarding-review-card">
                          <span class="onboarding-review-label">Coverage</span>
                          <strong id="onboardingReviewCoverage">Balanced run</strong>
                          <p id="onboardingReviewCoverageMeta">Broader coverage that keeps pushing after onboarding.</p>
                        </article>
                        <article class="onboarding-review-card">
                          <span class="onboarding-review-label">Code-aware diagnosis</span>
                          <strong id="onboardingReviewRepoTriage">Blind-only report</strong>
                          <p id="onboardingReviewRepoTriageMeta">Repo access is off, so this run stays purely blind.</p>
                        </article>
                      </div>
                    </section>

                    <section class="onboarding-sidecard">
                      <div class="onboarding-sidecard-head">
                        <h4>What happens next</h4>
                        <p>The swarm will treat this like a real customer mission.</p>
                      </div>
                      <article class="onboarding-launch-card">
                        <p id="onboardingLaunchSummary">The selected persona will clear onboarding, reach product value, and keep pushing on the goals you chose.</p>
                        <p class="onboarding-launch-note">Onboarding is a gate, not the finish line.</p>
                        <p class="onboarding-launch-sequence" id="onboardingLaunchSequence"></p>
                      </article>
                    </section>
                  </aside>
                </div>

                <input id="onboardingPersona" name="brand_persona" type="hidden" />
                <input id="onboardingBrandKey" name="brand_key" type="hidden" />
                <input id="onboardingScopeMode" name="scope_mode" type="hidden" value="deep_45m" />
                <textarea id="onboardingScenarios" name="scenario_list" hidden></textarea>

                <div class="app-onboarding-footer">
                  <p class="app-onboarding-message full" id="onboardingMessage" aria-live="polite"></p>
                  <div class="app-onboarding-actions full">
                    <button class="btn btn-ghost" id="onboardingPrevButton" type="button" hidden>Back</button>
                    <button class="btn btn-primary" id="onboardingNextButton" type="button">Continue</button>
                    <button class="btn btn-primary" id="onboardingSubmitButton" type="submit" hidden>Launch Mission</button>
                  </div>
                </div>
              </form>
            </section>

            <div class="app-legacy-plumbing" hidden>
              <span id="metricRuns">0</span>
              <span id="metricCompleted">0</span>
              <span id="metricFindings">0</span>
              <span id="metricRisk">0</span>
              <span id="metricPersonas">0</span>
              <span id="metricBugs">0</span>
              <span id="metricFriction">0</span>
              <span id="metricComplete">0%</span>
              <span id="appEvidenceMeta"></span>
              <span id="activeSwarmNotice"></span>
              <span id="brandChipsCount"></span>
              <div id="brandChips"></div>
              <span id="reportsCount">0</span>
              <div id="reportsItems"></div>
              <section id="reportDetail"></section>
            </div>
          </div>
        </div>
      </main>

      <script src="auth.js?v=20260329a"></script>
      <script src="dashboard-report-runtime.js?v=20260327b"></script>
      <script src="reports.js?v=20260401a"></script>
      <script src="dashboard.js?v=20260401c"></script>
      <script src="dashboard.js?v=20260401b"></script>
    </div>
  </body>
